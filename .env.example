# Configuração pública do app Firebase (Console > Configurações do projeto > Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL base das rotas pesadas (Cloud Functions / Cloud Run). Em desenvolvimento, aponte para o emulador.
VITE_API_BASE_URL=http://127.0.0.1:5001/demo-over-doc-tex/southamerica-east1

# Usa os emuladores locais do Firebase quando "true"
VITE_USE_FIREBASE_EMULATORS=true
