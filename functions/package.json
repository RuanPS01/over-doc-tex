{
  "name": "over-doc-tex-functions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --external:zod --sourcemap --outfile=lib/index.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
