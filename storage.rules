rules_version = '2';

// Regras do Storage. Layout de caminhos em shared/firestore/paths.ts (storagePaths).
// Sem servidor: os arquivos sobem do app de quem edita. As regras consultam o
// Firestore (no máximo duas leituras por pedido) para reaproveitar o mesmo
// modelo de permissão: membros do projeto e grants de snapshot por e-mail.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role(pid) {
      return firestore.get(/databases/(default)/documents/projects/$(pid)).data.members.get(request.auth.uid, null);
    }

    function isMember(pid) {
      return signedIn() && role(pid) != null;
    }

    function canEdit(pid) {
      return signedIn() && role(pid) in ['owner', 'editor'];
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    function grantedDocuments(pid, sid) {
      return firestore.get(/databases/(default)/documents/projects/$(pid)/snapshots/$(sid)/grants/$(request.auth.token.email.lower())).data.documentIds;
    }

    function snapshotExists(pid, sid) {
      return firestore.exists(/databases/(default)/documents/projects/$(pid)/snapshots/$(sid));
    }

    // Conteúdo endereçado por hash (sha256): imutável depois de enviado.
    match /projects/{pid}/blobs/{hash} {
      allow read: if isMember(pid);
      allow create: if canEdit(pid)
        && hash.matches('^[a-f0-9]{64}$')
        && request.resource.size < 50 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Última compilação de trabalho, feita no navegador e enviada por quem edita.
    match /projects/{pid}/builds/{documentId}/{fileName} {
      allow read: if isMember(pid);
      allow write: if canEdit(pid) && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }

    // Arquivos da versão ({documentId}.pdf, .synctex.gz, .pages.json): sobem ANTES do
    // documento do snapshot; depois que ele existe, nada mais entra nem muda.
    match /projects/{pid}/snapshots/{sid}/{fileName} {
      allow read: if isMember(pid)
        || (verifiedEmail() && fileName.split('\\.')[0] in grantedDocuments(pid, sid));
      allow create: if canEdit(pid) && !snapshotExists(pid, sid) && request.resource.size < 100 * 1024 * 1024;
      allow update, delete: if false;
    }

    // PDF de diff entre a versão base e esta (cache compartilhado, gerado por quem edita).
    match /projects/{pid}/snapshots/{sid}/diffs/{baseSid}/{documentId}/{fileName} {
      allow read: if isMember(pid) || (verifiedEmail() && documentId in grantedDocuments(pid, sid));
      allow create: if canEdit(pid) && request.resource.size < 100 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
