rules_version = '2';

// Regras do Firestore. Modelo detalhado em docs/06-banco-de-dados.md.
//
// Não há servidor: toda gravação vem do app de quem age. Por isso as regras
// validam também a coerência entre documentos gravados no mesmo lote
// (getAfter/existsAfter), por exemplo snapshot e contador do projeto.
//
// - Membros (members[uid]) leem tudo do projeto; owner/editor escrevem.
// - Revisores não são membros: o acesso vem de grants por e-mail verificado.
// - Coautores são convidados por e-mail (pendingMembers) e entram sozinhos ao aceitar.
// - Não há Cloud Storage: binários ficam aqui, em pedaços (ver "Arquivos em pedaços").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Sessão anônima (revisor pelo link) não tem e-mail: get() evita erro de avaliação.
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email', null) != null && request.auth.token.get('email_verified', false) == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function projectPath(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }

    function projectData(pid) {
      return get(projectPath(pid)).data;
    }

    function projectAfter(pid) {
      return getAfter(projectPath(pid)).data;
    }

    function roleIn(pid) {
      return projectData(pid).members.get(uid(), null);
    }

    function isMember(pid) {
      return signedIn() && roleIn(pid) != null;
    }

    function canEdit(pid) {
      return signedIn() && roleIn(pid) in ['owner', 'editor'];
    }

    function isOwner(pid) {
      return signedIn() && roleIn(pid) == 'owner';
    }

    function grantPath(pid, sid, email) {
      return /databases/$(database)/documents/projects/$(pid)/snapshots/$(sid)/grants/$(email);
    }

    function hasGrant(pid, sid) {
      return verifiedEmail() && exists(grantPath(pid, sid, myEmail()));
    }

    function reviewData(pid, rid) {
      return get(/databases/$(database)/documents/projects/$(pid)/reviews/$(rid)).data;
    }

    // Revisor por e-mail: o convidado na criação ou um dos e-mails acrescentados depois.
    function invitedEmail(review) {
      return review.reviewerEmail == myEmail() || myEmail() in review.get('reviewerEmails', []);
    }

    function isReviewer(pid, rid) {
      return verifiedEmail() && invitedEmail(reviewData(pid, rid));
    }

    // ------------------------------------------------ revisor pelo link (sem conta)
    // Revisão aberta "por link": o link leva um código aleatório que é o id de
    // reviews/{rid}/links/{código}. Quem abre o link entra com login anônimo e grava
    // a ficha de visitante em snapshots/{sid}/guests/{uid}, apontando a revisão e o
    // código. Vale enquanto a revisão continuar "por link" e o código existir.
    function guestPath(pid, sid) {
      return /databases/$(database)/documents/projects/$(pid)/snapshots/$(sid)/guests/$(uid());
    }

    function linkPath(pid, rid, token) {
      return /databases/$(database)/documents/projects/$(pid)/reviews/$(rid)/links/$(token);
    }

    function linkOpen(pid, rid, token) {
      return reviewData(pid, rid).get('access', 'email') == 'link' && exists(linkPath(pid, rid, token));
    }

    // Visitante com ficha válida nesta versão (para os arquivos e o diff dela).
    function isGuestOfSnapshot(pid, sid) {
      return signedIn()
        && exists(guestPath(pid, sid))
        && linkOpen(pid, get(guestPath(pid, sid)).data.reviewId, get(guestPath(pid, sid)).data.token);
    }

    // Visitante desta revisão.
    function isGuest(pid, rid) {
      let sid = reviewData(pid, rid).snapshotId;
      return signedIn()
        && exists(guestPath(pid, sid))
        && get(guestPath(pid, sid)).data.reviewId == rid
        && linkOpen(pid, rid, get(guestPath(pid, sid)).data.token);
    }

    // Documentos da revisão que trouxe o visitante a esta versão.
    function guestDocuments(pid, sid) {
      return reviewData(pid, get(guestPath(pid, sid)).data.reviewId).grantedDocumentIds;
    }

    // Identidade do visitante: o nome normalizado. O mesmo nome em outro aparelho é o mesmo revisor.
    function guestKey(pid, rid) {
      return get(guestPath(pid, reviewData(pid, rid).snapshotId)).data.guestKey;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ------------------------------------------------------ arquivos em pedaços
    // Um arquivo é um cabeçalho (tamanho, tipo, sha256, número de pedaços) mais a
    // subcoleção chunks/{índice}, com até 1.000.000 bytes por pedaço. Os pedaços
    // sobem antes e podem ser reenviados enquanto o cabeçalho não existe; o
    // cabeçalho entra no mesmo lote do último pedaço (existsAfter) e, a partir
    // dele, nada muda. Mesmos valores de src/lib/stored-files/chunks.ts.

    function validChunkIndex(index) {
      return index.matches('^(0|[1-9][0-9]{0,4})$');
    }

    function validChunk() {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 1000000;
    }

    // Coerência entre tamanho e número de pedaços sem divisão: o último pedaço
    // tem de 1 a chunkBytes bytes; arquivo vazio não tem pedaço.
    function validFileInfo(d, maxBytes) {
      return d.totalBytes is int && d.totalBytes >= 0 && d.totalBytes <= maxBytes
        && d.chunkBytes == 1000000
        && d.chunkCount is int
        && ((d.totalBytes == 0 && d.chunkCount == 0)
          || (d.chunkCount >= 1
            && (d.chunkCount - 1) * d.chunkBytes < d.totalBytes
            && d.totalBytes <= d.chunkCount * d.chunkBytes))
        && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
        && d.contentType is string && d.contentType.size() <= 200;
    }

    function validStoredFile(maxBytes) {
      let d = request.resource.data;
      return d.keys().hasOnly(['totalBytes', 'contentType', 'sha256', 'chunkCount', 'chunkBytes', 'createdBy', 'createdAt'])
        && validFileInfo(d, maxBytes)
        && d.createdBy == uid()
        && d.createdAt == request.time;
    }

    // O último pedaço precisa existir ao fim do lote que grava o cabeçalho.
    // `headerPath` é o caminho do cabeçalho relativo a documents, como texto.
    function lastChunkWritten(headerPath, info) {
      return info.chunkCount == 0
        || existsAfter(path('/databases/' + database + '/documents/' + headerPath + '/chunks/' + string(info.chunkCount - 1)));
    }

    function headerExists(headerPath) {
      return exists(path('/databases/' + database + '/documents/' + headerPath));
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && uid() == userId
        && onlyChanges(['displayName', 'photoURL', 'preferences', 'lastSeenAt']);
      allow delete: if false;

      // Configuração da IA do usuário (inclui chaves de API): só o dono.
      match /private/{docId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow update: if signedIn() && uid() == userId && onlyChanges(['read']);
        // Gravada pelo app de quem age: participante do projeto ou revisor da revisão citada.
        allow create: if signedIn()
          && request.resource.data.actorId == uid()
          && request.resource.data.read == false
          && (isMember(request.resource.data.projectId)
            || (request.resource.data.reviewId != null
              && (isReviewer(request.resource.data.projectId, request.resource.data.reviewId)
                || isGuest(request.resource.data.projectId, request.resource.data.reviewId))));
      }
    }

    // --------------------------------------------------------------- projects
    match /projects/{pid} {
      function next() {
        return request.resource.data;
      }

      function pending(doc) {
        return doc.get('pendingMembers', {});
      }

      function invitedRole() {
        return verifiedEmail() ? pending(resource.data).get(myEmail(), null) : null;
      }

      function editingDetails() {
        return canEdit(pid) && onlyChanges(['name', 'description', 'engine', 'mainDocumentId', 'updatedAt']);
      }

      // Congelar versão: contador +1 e latestSnapshotId do snapshot criado no mesmo lote.
      function freezingSnapshot() {
        return canEdit(pid)
          && onlyChanges(['counters', 'latestSnapshotId', 'updatedAt'])
          && next().counters.snapshots == resource.data.counters.snapshots + 1
          && next().counters.reviews == resource.data.counters.reviews
          && existsAfter(/databases/$(database)/documents/projects/$(pid)/snapshots/$(next().latestSnapshotId));
      }

      // Abrir revisão: contador de revisões +1 (o número da revisão é conferido nela).
      function openingReview() {
        return canEdit(pid)
          && onlyChanges(['counters', 'updatedAt'])
          && next().counters.reviews == resource.data.counters.reviews + 1
          && next().counters.snapshots == resource.data.counters.snapshots;
      }

      function profiles(doc) {
        return doc.get('memberProfiles', {});
      }

      // O dono gerencia membros e convites; o dono continua dono e convite nunca é de dono.
      // Ao remover alguém, a entrada dele em memberProfiles pode sair junto.
      function managingMembers() {
        return isOwner(pid)
          && onlyChanges(['members', 'memberIds', 'pendingMembers', 'memberProfiles', 'updatedAt'])
          && profiles(next()).diff(profiles(resource.data)).addedKeys().size() == 0
          && profiles(next()).diff(profiles(resource.data)).changedKeys().size() == 0
          && profiles(next()).keys().hasOnly(next().memberIds)
          && next().members[resource.data.ownerId] == 'owner'
          && next().members.values().hasOnly(['owner', 'editor', 'viewer'])
          && next().memberIds.toSet() == next().members.keys().toSet()
          && pending(next()).values().hasOnly(['editor', 'viewer']);
      }

      // memberProfiles mostra nome e e-mail dos membros (users/{uid} é privado):
      // cada um só grava a própria entrada.
      function onlyOwnProfile() {
        return profiles(next()).diff(profiles(resource.data)).affectedKeys().hasOnly([uid()]);
      }

      function updatingOwnProfile() {
        return isMember(pid) && onlyChanges(['memberProfiles']) && onlyOwnProfile();
      }

      // O convidado aceita sozinho: entra com o papel do convite e o convite some.
      function claimingInvite() {
        let role = invitedRole();
        return role != null
          && onlyChanges(['members', 'memberIds', 'pendingMembers', 'memberProfiles', 'updatedAt'])
          && onlyOwnProfile()
          && next().members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
          && next().members[uid()] == role
          && next().memberIds.toSet() == resource.data.memberIds.toSet().union([uid()].toSet())
          && pending(next()).diff(pending(resource.data)).affectedKeys().hasOnly([myEmail()])
          && !pending(next()).keys().hasAny([myEmail()]);
      }

      allow get: if isMember(pid) || invitedRole() != null;
      // A consulta precisa filtrar por memberIds array-contains uid.
      allow list: if signedIn() && uid() in resource.data.memberIds;
      allow create: if signedIn()
        && next().ownerId == uid()
        && next().members.keys().hasOnly([uid()])
        && next().members[uid()] == 'owner'
        && next().memberIds == [uid()]
        && pending(next()).size() == 0
        && next().counters == {'snapshots': 0, 'reviews': 0};
      allow update: if editingDetails() || freezingSnapshot() || openingReview() || managingMembers() || claimingInvite() || updatingOwnProfile();
      allow delete: if false;

      match /files/{fileId} {
        allow read: if isMember(pid);
        allow create, update: if canEdit(pid)
          && request.resource.data.updatedBy == uid()
          && (request.resource.data.content == null || request.resource.data.content.size() <= 524288);
        allow delete: if canEdit(pid);
      }

      // Binários do projeto, endereçados pelo sha256 e deduplicados entre versões.
      match /blobs/{hash} {
        function blobPath() {
          return 'projects/' + pid + '/blobs/' + hash;
        }

        allow read: if isMember(pid);
        allow create: if canEdit(pid)
          && hash.matches('^[a-f0-9]{64}$')
          && validStoredFile(26214400)
          && request.resource.data.sha256 == hash
          && lastChunkWritten(blobPath(), request.resource.data);
        allow update, delete: if false;

        match /chunks/{index} {
          allow read: if isMember(pid);
          allow create, update: if canEdit(pid)
            && validChunkIndex(index)
            && !headerExists(blobPath())
            && validChunk();
          allow delete: if false;
        }
      }

      match /documents/{documentId} {
        allow read: if isMember(pid);
        allow create: if canEdit(pid);
        // lastBuild é gravado pelo app depois da compilação no navegador.
        allow update: if canEdit(pid)
          && onlyChanges(['title', 'order', 'rootFileId', 'rootPath', 'engine', 'lastBuild', 'updatedAt']);
        allow delete: if canEdit(pid) && resource.data.role != 'main';
      }

      // Snapshot: criado uma vez, no mesmo lote que avança o contador; depois, imutável.
      match /snapshots/{sid} {
        allow get: if isMember(pid) || hasGrant(pid, sid) || isGuestOfSnapshot(pid, sid);
        allow list: if isMember(pid);
        allow create: if canEdit(pid)
          && request.resource.data.createdBy == uid()
          && request.resource.data.sequence == projectData(pid).counters.snapshots + 1
          && request.resource.data.sequence == projectAfter(pid).counters.snapshots
          && projectAfter(pid).latestSnapshotId == sid;
        allow update, delete: if false;

        // Ficha do visitante que entrou pelo link de uma revisão desta versão (ver isGuest).
        // Gravada por ele mesmo, com o código do link; o nome vira a identidade do revisor.
        match /guests/{guestUid} {
          function validGuest() {
            let d = request.resource.data;
            return signedIn() && uid() == guestUid
              && d.keys().hasOnly(['reviewId', 'token', 'name', 'guestKey', 'createdAt'])
              && d.reviewId is string
              && d.token is string && d.token.size() >= 20 && d.token.size() <= 128
              && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
              && d.guestKey is string && d.guestKey.size() >= 1 && d.guestKey.size() <= 80
              && reviewData(pid, d.reviewId).snapshotId == sid
              && linkOpen(pid, d.reviewId, d.token);
          }

          allow get: if (signedIn() && uid() == guestUid) || isMember(pid);
          allow list: if isMember(pid);
          allow create, update: if validGuest();
          allow delete: if canEdit(pid) || (signedIn() && uid() == guestUid);
        }

        // Acesso do revisor, por e-mail (em minúsculas). Gravado por quem edita o projeto.
        match /grants/{email} {
          allow get: if isMember(pid) || (verifiedEmail() && myEmail() == email);
          allow list: if isMember(pid);
          allow create, update: if canEdit(pid)
            && email == email.lower()
            && request.resource.data.grantedBy == uid()
            && request.resource.data.documentIds is list;
          allow delete: if canEdit(pid);
        }

        // PDF, SyncTeX e texto por página de cada documento ({documentId}.pdf etc.):
        // gravados antes do documento do snapshot; depois dele, nada entra nem muda.
        // O revisor lê só os documentos concedidos ao e-mail dele.
        match /files/{name} {
          function filePath() {
            return 'projects/' + pid + '/snapshots/' + sid + '/files/' + name;
          }

          function readable() {
            return isMember(pid)
              || (hasGrant(pid, sid)
                && name.split('\\.')[0] in get(grantPath(pid, sid, myEmail())).data.documentIds)
              || (isGuestOfSnapshot(pid, sid) && name.split('\\.')[0] in guestDocuments(pid, sid));
          }

          function beforeFreeze() {
            return !exists(/databases/$(database)/documents/projects/$(pid)/snapshots/$(sid));
          }

          allow read: if readable();
          allow create: if canEdit(pid)
            && name.matches('^[A-Za-z0-9_-]{1,128}[.](pdf|synctex|pages)$')
            && beforeFreeze()
            && validStoredFile(52428800)
            && lastChunkWritten(filePath(), request.resource.data);
          allow update, delete: if false;

          match /chunks/{index} {
            allow read: if readable();
            allow create, update: if canEdit(pid)
              && validChunkIndex(index)
              && beforeFreeze()
              && !headerExists(filePath())
              && validChunk();
            allow delete: if false;
          }
        }
      }

      match /reviews/{rid} {
        function amReviewer() {
          return verifiedEmail() && invitedEmail(resource.data);
        }

        function validAccess(d) {
          return d.get('access', 'email') in ['email', 'link']
            && d.get('reviewerEmails', []) is list
            && d.get('reviewerEmails', []).size() <= 50;
        }

        allow get: if isMember(pid) || amReviewer() || isGuest(pid, rid);
        allow list: if isMember(pid) || amReviewer();
        // Por e-mail, o convidado já tem a concessão na versão; por link, o e-mail pode vir vazio.
        allow create: if canEdit(pid)
          && next().requestedBy == uid()
          && next().number == projectData(pid).counters.reviews + 1
          && next().number == projectAfter(pid).counters.reviews
          && next().status == 'invited'
          && next().reviewerUid == null
          && next().reviewerEmail == next().reviewerEmail.lower()
          && validAccess(next())
          && existsAfter(/databases/$(database)/documents/projects/$(pid)/snapshots/$(next().snapshotId))
          && ((next().get('access', 'email') == 'link' && next().reviewerEmail == '')
            || existsAfter(grantPath(pid, next().snapshotId, next().reviewerEmail)));
        allow update: if (canEdit(pid)
            && onlyChanges(['title', 'description', 'status', 'closedAt', 'lastActivityAt'])
            && next().status in ['in_review', 'closed'])
          // Envio da revisão: mais e-mails e o tipo de acesso (com login ou pelo link).
          || (canEdit(pid)
            && onlyChanges(['access', 'reviewerEmails', 'lastActivityAt'])
            && validAccess(next()))
          || ((amReviewer() || isGuest(pid, rid))
            && onlyChanges(['status', 'reviewerUid', 'reviewerName', 'lastActivityAt'])
            && next().reviewerUid == uid()
            && next().status in ['in_review', 'changes_requested', 'approved']);
        allow delete: if false;

        // Código do link de acesso sem conta (o id é o código). Só quem edita vê, cria e revoga;
        // o visitante prova que o conhece ao gravar a ficha (exists, nas regras acima).
        match /links/{token} {
          allow read: if canEdit(pid);
          allow create: if canEdit(pid)
            && token.size() >= 20 && token.size() <= 128
            && request.resource.data.createdBy == uid();
          allow update: if false;
          allow delete: if canEdit(pid);
        }

        match /threads/{tid} {
          function canParticipate() {
            return isMember(pid) || isReviewer(pid, rid) || isGuest(pid, rid);
          }

          // Comentário de visitante leva a identidade dele (nome normalizado); os demais, nenhuma.
          function validAuthorKey(d) {
            return d.get('authorKey', null) == null || (isGuest(pid, rid) && d.authorKey == guestKey(pid, rid));
          }

          function validNewThread() {
            let d = request.resource.data;
            let review = reviewData(pid, rid);
            return d.createdBy == uid()
              && d.projectId == pid
              && d.reviewId == rid
              && d.snapshotId == review.snapshotId
              && d.documentId in review.grantedDocumentIds
              && d.kind in ['text', 'pin']
              && d.anchor.type == d.kind
              && d.anchor.page is int && d.anchor.page >= 1
              // Thread levada da rodada anterior pode nascer "desatualizada" (trecho não encontrado).
              && (d.status == 'open' || (d.status == 'outdated' && d.get('carriedFromThreadId', null) is string))
              && d.resolution == null
              && d.commentCount in [0, 1]
              && d.participantIds == [uid()];
          }

          // Contador mantido pelo app: +1 por comentário, e o autor entra nos participantes.
          function countingComment() {
            return onlyChanges(['commentCount', 'lastCommentAt', 'participantIds', 'updatedAt'])
              && request.resource.data.commentCount == resource.data.commentCount + 1
              && request.resource.data.participantIds.toSet() == resource.data.participantIds.toSet().union([uid()].toSet());
          }

          function changingStatus() {
            return onlyChanges(['status', 'resolution', 'updatedAt'])
              && (request.resource.data.resolution == null || request.resource.data.resolution.by == uid());
          }

          // Ao congelar a versão seguinte, quem edita carimba em qual versão a correção entrou.
          function stampingFix() {
            return canEdit(pid)
              && onlyChanges(['resolution', 'updatedAt'])
              && resource.data.status == 'resolved'
              && resource.data.resolution.fixedInSnapshotId == null
              && request.resource.data.resolution.diff(resource.data.resolution).affectedKeys().hasOnly(['fixedInSnapshotId']);
          }

          allow read: if canParticipate();
          allow create: if canParticipate() && validNewThread();
          allow update: if canParticipate() && (countingComment() || changingStatus() || stampingFix());
          allow delete: if false;

          match /comments/{cid} {
            allow read: if canParticipate();
            allow create: if canParticipate()
              && request.resource.data.authorId == uid()
              && request.resource.data.kind in ['comment', 'status_change']
              && request.resource.data.body is string
              && request.resource.data.body.size() <= 10000
              && validAuthorKey(request.resource.data);
            // Edição e exclusão lógica pelo próprio autor (visitante: o mesmo nome, em qualquer aparelho).
            allow update: if signedIn()
              && (resource.data.authorId == uid()
                || (resource.data.get('authorKey', null) != null && isGuest(pid, rid) && resource.data.authorKey == guestKey(pid, rid)))
              && onlyChanges(['body', 'editedAt', 'deletedAt']);
            allow delete: if false;
          }
        }
      }

      // Cache do diff (gerado no navegador): gravado por quem edita, nunca alterado.
      // O PDF fica nos pedaços deste documento; o campo `pdf` faz papel de cabeçalho.
      match /diffs/{diffKey} {
        function diffPath() {
          return 'projects/' + pid + '/diffs/' + diffKey;
        }

        function validPdf(pdf) {
          return pdf == null
            || (pdf.keys().hasOnly(['totalBytes', 'contentType', 'sha256', 'chunkCount', 'chunkBytes'])
              && validFileInfo(pdf, 52428800)
              && lastChunkWritten(diffPath(), pdf));
        }

        allow get: if isMember(pid) || hasGrant(pid, resource.data.targetSnapshotId) || isGuestOfSnapshot(pid, resource.data.targetSnapshotId);
        allow list: if isMember(pid);
        allow create: if canEdit(pid)
          && request.resource.data.createdBy == uid()
          && validPdf(request.resource.data.get('pdf', null));
        allow update, delete: if false;

        match /chunks/{index} {
          function diff() {
            return get(/databases/$(database)/documents/projects/$(pid)/diffs/$(diffKey)).data;
          }

          allow read: if isMember(pid)
            || (hasGrant(pid, diff().targetSnapshotId)
              && diff().documentId in get(grantPath(pid, diff().targetSnapshotId, myEmail())).data.documentIds)
            || (isGuestOfSnapshot(pid, diff().targetSnapshotId)
              && diff().documentId in guestDocuments(pid, diff().targetSnapshotId));
          allow create, update: if canEdit(pid)
            && validChunkIndex(index)
            && !headerExists(diffPath())
            && validChunk();
          allow delete: if false;
        }
      }

      // Conversas com a IA são privadas de quem as criou.
      match /aiConversations/{cid} {
        allow read, delete: if isMember(pid) && resource.data.createdBy == uid();
        allow create: if isMember(pid) && request.resource.data.createdBy == uid();
        allow update: if isMember(pid) && resource.data.createdBy == uid()
          && onlyChanges(['title', 'lastTask', 'updatedAt']);

        match /messages/{mid} {
          function ownsConversation() {
            return get(/databases/$(database)/documents/projects/$(pid)/aiConversations/$(cid)).data.createdBy == uid();
          }

          allow read, create: if isMember(pid) && ownsConversation();
          allow update, delete: if false;
        }
      }

      match /referenceChecks/{checkId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid) && request.resource.data.createdBy == uid();
        allow update, delete: if false;
      }
    }

    // Painel "Minhas revisões": collectionGroup('reviews') filtrado pelo e-mail do revisor
    // (reviewerEmail == eu, ou reviewerEmails contém o meu).
    match /{path=**}/reviews/{rid} {
      allow list: if verifiedEmail() && invitedEmail(resource.data);
    }
  }
}
