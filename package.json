{
  "name": "over-doc-tex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor LaTeX PWA com revisão estilo Pull Request, diff visual em PDF e assistente de IA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build && node -e \"require('node:fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "test:rules": "npm --prefix tests/rules test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^1.52.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@siglum/engine": "0.1.4",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "firebase": "^13.1.0",
    "lucide-react": "^1.65.0",
    "marked": "^18.1.2",
    "openai": "^6.49.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.15.3",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "xzwasm": "0.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
